{
  "name": "state-decorator",
  "version": "8.0.0",
  "description": "React state management library",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/GlobalSport/state-decorator.git"
  },
  "author": "Damien Garbarino <d.garbarino@mycoachsport.com>",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "test": "jest tests/*",
    "bump-beta": "yarn test && yarn clean && yarn bundle && yarn copy",
    "bump-version": "yarn test && yarn clean && yarn bundle && bump --commit 'build: release v%s' --tag --push && yarn copy",
    "clean": "rimraf ./lib",
    "lint": "yarn eslint src/**.ts",
    "copy": "copyfiles -f package.json README.md LICENSE lib && json -I -f lib/package.json -e \"this.private=false; this.devDependencies=undefined; this.optionalDependencies=undefined; this.scripts=undefined; this.husky=undefined; this['lint-staged']=undefined; \"",
    "build": "yarn bundle && yarn copy",
    "build:dev": "yarn bundle:dev && yarn copy",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir lib",
    "bundle": "cross-env NODE_ENV=production rolldown -c rolldown.config.mjs && yarn types",
    "bundle:dev": "cross-env NODE_ENV=development rolldown -c rolldown.config.mjs && yarn types",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.59",
    "@swc/core": "^1.2.126",
    "@swc/jest": "^0.2.24",
    "@testing-library/react-hooks": "^5.1.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^17.0.0",
    "@types/use-sync-external-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "copyfiles": "^2.2.0",
    "cross-env": "^5.2.0",
    "eslint": "^8.34.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "install": "^0.13.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.3.1",
    "json": "^9.0.6",
    "lint-staged": "^15.2.10",
    "prettier": "^2.1.5",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "rimraf": "^4.1.2",
    "rolldown": "^1.3.2",
    "tslib": "^2.3.1",
    "typescript": "^5.6.0",
    "version-bump-prompt": "^6.1.0"
  },
  "peerDependencies": {
    "react": ">=16.9.0"
  },
  "lint-staged": {
    "src/*.{ts,tsx}": [
      "eslint",
      "prettier --write"
    ],
    "*.{js,css,md}": "prettier --write"
  },
  "keywords": [
    "state",
    "typescript",
    "react",
    "javascript"
  ],
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "use-sync-external-store": "^1.6.0"
  }
}
